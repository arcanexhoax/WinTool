<Window x:Class="WinTool.WinUI.Views.Shortcuts.RunWithArgsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:WinTool.WinUI.Properties"
        xmlns:sys="using:System"
        Title="{x:Bind sys:String.Format(p:Resources.RunFormat, ViewModel.FileName), Mode=OneWay}">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          PointerPressed="OnPointerPressed"
          RowDefinitions="*,80">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Enter"
                                 Invoked="OnRunInvoked" />
            <KeyboardAccelerator Key="Escape"
                                 Invoked="OnCancelInvoked" />
        </Grid.KeyboardAccelerators>

        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
              RowDefinitions="Auto,*,Auto"
              Padding="26">
            <TextBlock Text="{x:Bind sys:String.Format(p:Resources.RunFormat, ViewModel.FileName), Mode=OneWay}"
                       ToolTipService.ToolTip="{x:Bind ViewModel.FullFilePath, Mode=OneWay}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />

            <TextBox x:Name="ArgsTextBox"
                     Text="{x:Bind ViewModel.Args, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Loaded="OnArgsLoaded"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="0 16 0 0"
                     Grid.Row="1" />

            <Expander Header="{x:Bind p:Resources.Options}"
                      IsExpanded="{x:Bind ViewModel.AreOptionsOpened, Mode=TwoWay}"
                      Margin="0 16 0 0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Grid.Row="2">
                <StackPanel>
                    <CheckBox Content="{x:Bind p:Resources.RunAsAdmin}"
                              IsChecked="{x:Bind ViewModel.RunAsAdmin, Mode=TwoWay}" />
                    <CheckBox Content="{x:Bind p:Resources.KeepConsoleOpen}"
                              IsChecked="{x:Bind ViewModel.KeepConsoleOpen, Mode=TwoWay}"
                              Margin="0 8 0 0" />
                </StackPanel>
            </Expander>
        </Grid>

        <Border Padding="26 0"
                Grid.Row="1">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">

                <Button Content="{x:Bind p:Resources.Run}"
                        Command="{x:Bind ViewModel.RunCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" />
                <Button Content="{x:Bind p:Resources.Cancel}"
                        Command="{x:Bind ViewModel.CloseWindowCommand}"
                        HorizontalAlignment="Stretch"
                        Grid.Column="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
