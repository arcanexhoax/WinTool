<Page x:Class="WinTool.WinUI.Views.Shortcuts.ShortcutsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:p="using:WinTool.WinUI.Properties"
      xmlns:shortcuts="using:WinTool.WinUI.Views.Shortcuts"
      NavigationCacheMode="Required">
    <Border Margin="8 0 0 0"
            Padding="20 0 20 36">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Text="{x:Bind p:Resources.Shortcuts}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       MaxWidth="1000" />

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0 24 0 0"
                          Padding="0 0 20 0"
                          Grid.Row="1">
                <StackPanel MaxWidth="1000">
                    <TextBlock Text="{x:Bind p:Resources.WindowsExplorer}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Shortcuts}"
                                  Margin="0 8 0 0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinHeight="60"
                                        Margin="0 0 0 2"
                                        Padding="20 10">
                                    <shortcuts:ShortcutView />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
