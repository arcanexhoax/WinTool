<UserControl x:Class="WinTool.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:WinTool.Properties"
             xmlns:ctrl="clr-namespace:WinTool.UI.Controls"
             xmlns:ui="clr-namespace:WinTool.UI"
             xmlns:settings="clr-namespace:WinTool.ViewModels.Settings"
             d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Border Style="{DynamicResource MainContentBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Static p:Resources.Settings}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       MaxWidth="1000" />

            <ScrollViewer ui:ScrollViewerExtensions.AutoHideScrollBars="True"
                          Margin="0 24 0 0"
                          Padding="0 0 20 0"
                          Grid.Row="1">
                <StackPanel MaxWidth="1000">
                    <TextBlock Text="{x:Static p:Resources.General}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Border Style="{DynamicResource CardBorderStyle}"
                            Margin="0 8 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{StaticResource Icon.Language}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Margin="0 0 18 0" />

                            <TextBlock Text="{x:Static p:Resources.Language}"
                                       Grid.Column="1" />

                            <ComboBox SelectedValue="{Binding SelectedLanguage}"
                                      SelectedValuePath="Tag"
                                      Width="150"
                                      HorizontalAlignment="Right"
                                      Grid.Column="3">
                                <ComboBoxItem Content="English"
                                              Tag="en" />
                                <ComboBoxItem Content="Deutsch"
                                              Tag="de" />
                                <ComboBoxItem Content="Español"
                                              Tag="es" />
                                <ComboBoxItem Content="Français"
                                              Tag="fr" />
                                <ComboBoxItem Content="Polski"
                                              Tag="pl" />
                                <ComboBoxItem Content="Português"
                                              Tag="pt" />
                                <ComboBoxItem Content="Русский"
                                              Tag="ru" />
                                <ComboBoxItem Content="Türkçe"
                                              Tag="tr" />
                                <ComboBoxItem Content="Українська"
                                              Tag="uk" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardBorderStyle}"
                            Margin="0 2 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{StaticResource Icon.Power}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Margin="0 0 18 0" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Static p:Resources.Animations}" />

                                <TextBlock Text="{x:Static p:Resources.AnimationsAutoDescription}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                           Margin="0 4 0 0" />
                            </StackPanel>

                            <ComboBox SelectedValue="{Binding SelectedAnimationMode}"
                                      SelectedValuePath="Tag"
                                      Width="150"
                                      HorizontalAlignment="Right"
                                      Grid.Column="3">
                                <ComboBoxItem Content="{x:Static p:Resources.Auto}"
                                              Tag="{x:Static settings:AnimationMode.Auto}" />
                                <ComboBoxItem Content="{x:Static p:Resources.On}"
                                              Tag="{x:Static settings:AnimationMode.On}" />
                                <ComboBoxItem Content="{x:Static p:Resources.Off}"
                                              Tag="{x:Static settings:AnimationMode.Off}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static p:Resources.Startup}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0 36 0 0" />

                    <Border Style="{DynamicResource CardBorderStyle}"
                            Margin="0 8 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{StaticResource Icon.PowerButton}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Margin="0 0 18 0" />

                            <TextBlock Text="{x:Static p:Resources.LaunchOnStartup}"
                                       Grid.Column="1" />

                            <ctrl:ToggleSwitch IsChecked="{Binding LaunchOnWindowsStartup}"
                                               ShowStateContent="True"
                                               StateContentPosition="Left"
                                               Grid.Column="3" />
                        </Grid>
                    </Border>

                    <Border Style="{DynamicResource CardBorderStyle}"
                            Margin="0 2 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{StaticResource Icon.Shield}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Margin="0 0 18 0" />

                            <TextBlock Text="{x:Static p:Resources.AlwaysRunAsAdmin}"
                                       Grid.Column="1" />

                            <ctrl:ToggleSwitch IsChecked="{Binding AlwaysRunAsAdmin}"
                                               ShowStateContent="True"
                                               StateContentPosition="Left"
                                               Grid.Column="3" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static p:Resources.Appearance}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0 36 0 0" />

                    <Border Style="{DynamicResource CardBorderStyle}"
                            Margin="0 8 0 0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{StaticResource Icon.Theme}"
                                       FontFamily="{StaticResource SymbolThemeFontFamily}"
                                       FontSize="18"
                                       Margin="0 0 18 0" />
                            <TextBlock Text="{x:Static p:Resources.AppTheme}"
                                       HorizontalAlignment="Left"
                                       Grid.Column="1" />

                            <ComboBox SelectedValue="{Binding SelectedAppTheme}"
                                      SelectedValuePath="Tag"
                                      Width="150"
                                      HorizontalAlignment="Right"
                                      Grid.Column="2">
                                <ComboBoxItem Content="{x:Static p:Resources.System}"
                                              Tag="{x:Static settings:AppTheme.System}" />
                                <ComboBoxItem Content="{x:Static p:Resources.Light}"
                                              Tag="{x:Static settings:AppTheme.Light}" />
                                <ComboBoxItem Content="{x:Static p:Resources.Dark}"
                                              Tag="{x:Static settings:AppTheme.Dark}" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="{x:Static p:Resources.About}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0 36 0 0" />

                    <Expander Margin="0 8 0 0"
                              HorizontalContentAlignment="Stretch"
                              Padding="0 0 20 0">
                        <Expander.Header>
                            <Border Padding="20 10"
                                    MinHeight="60">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Image Source="/Resources/logo.png"
                                           Width="20"
                                           Height="20"
                                           Margin="0 0 18 0"
                                           VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Static p:Resources.WinTool}" />
                                        <TextBlock Text="{x:Static p:Resources.AboutDescription}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                                   Margin="0 4 0 0" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding CurrentVersion}"
                                               Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                               Grid.Column="2" />
                                </Grid>
                            </Border>
                        </Expander.Header>

                        <StackPanel>
                            <Border Style="{DynamicResource CardBorderStyle}"
                                    Margin="0 0 -20 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Content="{x:Static p:Resources.CheckForUpdates}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Margin="20 0 0 0"
                                            Grid.RowSpan="2"
                                            Grid.Column="2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.NotChecked}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.UpToDate}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Checking}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{x:Static p:Resources.CheckingForUpdates}" />
                                        <ProgressBar IsIndeterminate="True"
                                                     Height="4"
                                                     Margin="0 8 0 0" />
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal"
                                                Margin="20 0 0 0"
                                                Grid.Column="2">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Available}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Button Command="{Binding ShowReleaseNotesCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{x:Static p:Resources.WhatsNew}" />
                                                <TextBlock Text="{StaticResource Icon.Open}"
                                                           FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                           FontSize="12"
                                                           Margin="6 0 0 0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="{x:Static p:Resources.DownloadAndInstall}"
                                                Command="{Binding DownloadAndInstallCommand}"
                                                Style="{DynamicResource AccentButtonStyle}"
                                                Margin="8 0 0 0" />
                                    </StackPanel>

                                    <Button Content="{x:Static p:Resources.Cancel}"
                                            Command="{Binding CancelUpdateCommand}"
                                            Margin="20 0 0 0"
                                            Grid.Column="2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Downloading}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Content="{x:Static p:Resources.TryAgain}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Margin="20 0 0 0"
                                            Grid.Column="2">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Error}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock Text="{x:Static p:Resources.LatestVersionInstalled}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.UpToDate}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Available}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        
                                        <TextBlock Text="{x:Static p:Resources.NewVersionAvailable}" />
                                        <TextBlock Text="{Binding AvailableVersion}"
                                                   Margin="4 0 0 0"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Downloading}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{x:Static p:Resources.DownloadingUpdate}" />
                                        <ProgressBar Height="4"
                                                     Margin="0 8 0 0"
                                                     Value="{Binding DownloadProgress}" />
                                        <TextBlock Text="{Binding DownloadProgressText}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{DynamicResource SystemFillColorNeutralBrush}"
                                                   Margin="0 4 0 0" />
                                    </StackPanel>

                                    <TextBlock Text="{x:Static p:Resources.LaunchingInstaller}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Installing}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding UpdateErrorMessage}"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlockStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UpdateState}" Value="{x:Static settings:UpdateState.Error}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Border Style="{DynamicResource CardBorderStyle}"
                                    Margin="0 0 -20 0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Static p:Resources.GitHubDescription}" />

                                    <Button Command="{Binding OpenGitHubCommand}"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            Grid.Column="1">
                                        <TextBlock Text="{StaticResource Icon.Open}"
                                                   FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                   FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
