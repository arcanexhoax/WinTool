<Application x:Class="WinTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinTool"
             xmlns:p="clr-namespace:WinTool.Properties"
             xmlns:tb="http://www.hardcodet.net/taskbar">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <ResourceDictionary Source="/UI/Controls/TextBlock.xaml" />
                <ResourceDictionary Source="/UI/Controls/Border.xaml" />
                <ResourceDictionary Source="/UI/Controls/Expander.xaml" />
                <ResourceDictionary Source="/UI/Controls/Colors.xaml" />
                <ResourceDictionary Source="/UI/Controls/Shortcut.xaml" />
                <ResourceDictionary Source="/UI/Controls/ToggleSwitch.xaml" />
                <ResourceDictionary Source="/UI/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Resources/icon.ico"
                            PopupActivation="RightClick"
                            TrayLeftMouseDown="OnTrayIconOpen"
                            ToolTipText="{x:Static p:Resources.TrayToolTip}"
                            Visibility="Collapsed">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static p:Resources.Open}"
                                  Click="OnTrayIconOpen" />
                        <Separator />
                        <MenuItem Header="{x:Static p:Resources.Close}"
                                  Click="OnTrayIconClose" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
