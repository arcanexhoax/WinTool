<Wix
    xmlns="http://wixtoolset.org/schemas/v4/wxs"
    xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
    xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

    <Bundle Name="WinTool"
            Manufacturer="hoax"
            Version="$(ProductVersion)"
            UpgradeCode="CCF1AA05-9E64-4973-8E2C-B6B4AA88A493"
            IconSourceFile="..\..\src\WinTool\Resources\icon.ico">

        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication LicenseUrl="https://github.com/arcanexhoax/WinTool/blob/master/LICENSE"
                                                    LaunchTarget="[InstallFolder]\WinTool.exe"
                                                    LaunchWorkingFolder="[InstallFolder]"
                                                    ShowVersion="yes"
                                                    Theme="hyperlinkLargeLicense" />
        </BootstrapperApplication>

        <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]WinTool" bal:Overridable="yes" />

        <netfx:DotNetCoreSearch Id="DotNetDesktopRuntimeSearch"
                                Variable="DotNetDesktopRuntimeVersion"
                                RuntimeType="desktop"
                                Platform="x64"
                                MajorVersion="11" />

        <Chain>
            <ExePackage Id="DotNetDesktopRuntime"
                        DisplayName="Microsoft .NET 11 Desktop Runtime"
                        DetectCondition="DotNetDesktopRuntimeVersion &gt;= v11.0.0"
                        InstallArguments="/install /quiet /norestart"
                        RepairArguments="/repair /quiet /norestart"
                        UninstallArguments="/uninstall /quiet /norestart"
                        PerMachine="yes"
                        Permanent="yes"
                        Vital="yes"
                        Cache="remove">

                <ExePackagePayload Name="windowsdesktop-runtime-11.0.0-win-x64.exe"
                                   DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/11.0.0/windowsdesktop-runtime-11.0.0-win-x64.exe"
                                   Hash="ca20dba0c69dd6ae3932d2a42beeeecc4f4ece0be084f9921b001c8acd4ece7999df73ede76b87b6ae0d34974112ddd1c828fafad487df27c25e59e7f794c059"
                                   Size="62332904" />
            </ExePackage>

            <MsiPackage Id="WinToolMsi"
                        SourceFile="$(WinTool.Installer.TargetPath)"
                        Compressed="yes"
                        Visible="no"
                        Vital="yes">

                <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
            </MsiPackage>
        </Chain>
    </Bundle>
</Wix>
